@* ProductoForm — Unidad 1, Clases 6-7: EditForm + DataAnnotationsValidator *@
@inject IProductoService ProductoService

<EditForm Model="Modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-errors" />

    @if (mensajeError is not null)
    {
        <AlertError Mensaje="@mensajeError" OnCerrar="() => mensajeError = null" />
    }

    <div class="campo-form">
        <label for="nombre">Nombre</label>
        <InputText id="nombre" @bind-Value="Modelo.Nombre" class="form-control" />
        <ValidationMessage For="() => Modelo.Nombre" />
    </div>

    <div class="campo-form-row">
        <div class="campo-form">
            <label for="marca">Marca</label>
            <InputText id="marca" @bind-Value="Modelo.Marca" class="form-control" />
        </div>

        <div class="campo-form">
            <label for="categoria">Categoría</label>
            <InputSelect id="categoria" @bind-Value="Modelo.CategoriaId" class="form-select">
                <option value="0">Seleccioná una categoría</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Modelo.CategoriaId" />
        </div>
    </div>

    <div class="campo-form">
        <label for="descripcion">Descripción</label>
        <InputTextArea id="descripcion" @bind-Value="Modelo.Descripcion" class="form-control" rows="3" />
    </div>

    <div class="campo-form">
        <label for="caracteristicas">Características (una por línea)</label>
        <InputTextArea id="caracteristicas" @bind-Value="Modelo.Caracteristicas" class="form-control" rows="5" placeholder="Procesador: ...&#10;Memoria RAM: ..." />
        <ValidationMessage For="() => Modelo.Caracteristicas" />
    </div>

    <div class="campo-form">
        <label for="imagen">URL de imagen (opcional)</label>
        <InputText id="imagen" @bind-Value="Modelo.ImagenUrl" class="form-control" placeholder="https://... o /img/productos/archivo.webp" />
        <ValidationMessage For="() => Modelo.ImagenUrl" />
    </div>

    <div class="campo-form-row">
        <div class="campo-form">
            <label for="precio">Precio</label>
            <InputNumber id="precio" @bind-Value="Modelo.Precio" class="form-control" />
            <ValidationMessage For="() => Modelo.Precio" />
        </div>

        <div class="campo-form">
            <label for="stock">Stock actual</label>
            <InputNumber id="stock" @bind-Value="Modelo.Stock" class="form-control" />
            <ValidationMessage For="() => Modelo.Stock" />
        </div>

        <div class="campo-form">
            <label for="stockMinimo">Stock mínimo</label>
            <InputNumber id="stockMinimo" @bind-Value="Modelo.StockMinimo" class="form-control" />
            <ValidationMessage For="() => Modelo.StockMinimo" />
        </div>
    </div>

    <div class="campo-form campo-checkbox">
        <label for="disponible" class="label-checkbox">
            <InputCheckbox id="disponible" @bind-Value="Modelo.Disponible" />
            Disponible para la venta
        </label>
        <ValidationMessage For="() => Modelo.Disponible" />
    </div>

    <div class="campo-form campo-checkbox">
        <label for="destacado" class="label-checkbox">
            <InputCheckbox id="destacado" @bind-Value="Modelo.Destacado" />
            Destacado (aparece en el carrusel del catálogo)
        </label>
    </div>

    <div class="acciones-form">
        <button type="submit" class="btn-primario" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button>
        <button type="button" class="btn-secundario" @onclick="Cancelar">Cancelar</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public Producto Modelo { get; set; } = default!;
    [Parameter] public EventCallback<Producto> OnGuardado { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private List<Categoria> categorias = new();

    protected override async Task OnInitializedAsync()
        => categorias = await ProductoService.ObtenerCategorias();

    private string? mensajeError;
    private bool guardando;

    private async Task Guardar()
    {
        guardando = true;
        mensajeError = null;
        try
        {
            var guardado = Modelo.Id == 0
                ? await ProductoService.Crear(Modelo)
                : await ProductoService.Actualizar(Modelo);

            await OnGuardado.InvokeAsync(guardado);
        }
        catch (InvalidOperationException ex)
        {
            // Errores esperables (conflicto de concurrencia, falla al guardar): se muestran
            // en el formulario y el usuario no pierde lo que cargó.
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Cancelar() => await OnCancelar.InvokeAsync();
}
